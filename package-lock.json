{
  "name": "stellar-startup",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "stellar-startup",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "devDependencies": {
        "typescript": "^5.0.0"
      }
    },
    "apps/web": {
      "name": "web",
      "version": "0.0.0",
      "dependencies": {
        "@stellar-startup/tsconfig": "*"
      }
    },
    "node_modules/@stellar-startup/tsconfig": {
      "resolved": "packages/tsconfig",
      "link": true
    },
    "packages/tsconfig": {
      "name": "@stellar-startup/tsconfig",
      "version": "0.0.0",
      "license": "ISC"
    }
  }
}
