{
  "name": "@backend/app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "jest",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "node-fetch": "^3.3.2",
    "@stellar/stellar-sdk": "^13.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zod": "^3.23.2",
    "@supabase/supabase-js": "^2.39.0",
    "jsonwebtoken": "^9.0.0",
    "@soroswap/sdk": "^1.0.0",
    "stellar-sdk": "^11.0.0",
    "supabase-js": "^2.39.0",
    "helmet": "^7.1.0",
    "@noble/hashes": "^1.3.0",
    "@stellar/stellar-base": "^11.2.1",
    "supabase": "^2.39.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node-fetch": "^3.1.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.13",
    "tsx": "^4.7.0",
    "txsupervisor": "^0.18.3",
    "vitest": "^1.2.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^6.3.2",
    "tsx-": "^4.7.0",
    "@types/jsonwebtoken": "^9.0.6",
    "tsup": "^8.0.0",
    "@types/cors": "^2.8.19",
    "@typescrypt/eslint": "^6.21.0",
    "eslint": "^8.57.0",
    "ts-node": "^20.11.0",
    "@types/morgan": "^1.8.12",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0"
  },
  "type": "module",
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx$": [
        "ts-jest",
        {
          "useEsm": true
        }
      ]
    },
    "moduleNameMapper": {
      "^(\\.\\.?.*)\\.js($)": "$1ts$2"
    }
  }
}
