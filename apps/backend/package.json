{
  "name": "@bounty/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node --watch src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.6",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "@noble/hashes": "^1.3.0",
    "@stellar/stellar-base": "^11.2.1",
    "supabase": "^2.39.0",
    "zod": "^3.23.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.9",
    "@types/jest": "^29.7.0",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.3",
    "@typescrypt/eslint": "^6.21.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.1",
    "ts-jest": "^29.1.2",
    "ts-node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/*.test.ts"],
    "transform": {
      "^.+\\.tsx$": ["ts-jest", { "useEsm": true }]
    },
    "moduleNameMapper": {
      "^(\\.\\.?.*)\\.js($)": "$1ts$2"
    }
  }
}
