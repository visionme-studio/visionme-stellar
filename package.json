{
  "name": "monorepo",
  "private": true,
  "scripts": {
    "test": "turbo run test",
    "prepare": "husky install",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev": "next dev",
    "format": "prettier --write .",
    "postinstall": "patch-package",
    "dev_typecheck": "turbo run dev_typecheck"
  },
  "devDependencies": {
    "eslint": "^9.21.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.4.2",
    "typescript-eslint": "^8.0.0",
    "turbo": "^2.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "version": "1.0.0",
  "lint-staged": {
    "*.*": "prettier --write"
  }
}
