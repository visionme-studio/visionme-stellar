{
  "name": "project",
  "private": true,
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "prepare": "husky install",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "format": "prettier --write .",
    "postinstall": "patch-package",
    "dev_typecheck": "turbo run dev_typecheck"
  },
  "devDependencies": {
    "eslint": "^9.21.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "turbo": "^2.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "version": "1.0.0",
  "lint-staged": {
    "*.*": "prettier --write"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.2.4",
  "description": "A GitHub bounty project.",
  "license": "MIT"
}
